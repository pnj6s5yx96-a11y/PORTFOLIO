# Application
APP_ENV=production
APP_URL=https://votre-domaine.tld
APP_KEY=changez-cette-cle-longue-et-aleatoire

# Database (MAMP macOS defaults: localhost:8889 / root / root)
DB_HOST=127.0.0.1
DB_PORT=8889
DB_NAME=PORTFOLIO
DB_USER=root
DB_PASSWORD=root

# Google Search Console (optional: paste only the verification token)
GOOGLE_SITE_VERIFICATION=

# Profile / contact
SITE_OWNER=Michael AKAKPOSSE
SITE_EMAIL=bonjour@votre-domaine.tld
WHATSAPP_NUMBER=22900000000
SEO_LOCALITY=
SEO_COUNTRY=

# SMTP – required for reliable delivery in production
SMTP_HOST=smtp.votre-fournisseur.tld
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=bonjour@votre-domaine.tld
